# Dev local — backend AllInOne (không chứa secret; mobile dùng PKCE public client)
EXPO_PUBLIC_API_URL=http://localhost:30000
EXPO_PUBLIC_OIDC_AUTHORITY=http://localhost:30000
# Client public riêng cho mobile — đăng ký ở backend trước khi login thật (xem docs/auth.md).
# Giá trị mặc định tạm thời trỏ client web để giữ cấu hình rõ ràng; login thật cần client public.
EXPO_PUBLIC_OIDC_CLIENT_ID=vue-admin-client
