{
	"compilerOptions": {
		"target": "ESNext", // Phiên bản đích của mã sau khi biên dịch (ECMAScript).
		"module": "ESNext", // Loại hệ thống mô-đun được sử dụng. ESNext hỗ trợ nhiều tính năng hơn, ví dụ như dynamic import.
		"lib": ["ESNext", "DOM", "DOM.Iterable"], // Các file thư viện cần bao gồm. Các file thư viện DOM, DOM.Iterable và ESNext là các dependency khá cơ bản trong phát triển TypeScript.
		"useDefineForClassFields": true,
		"skipLibCheck": true, // Bỏ qua kiểm tra của trình biên dịch đối với các file thư viện được import, để tăng tốc độ build
		"allowJs": true, // Cho phép biên dịch file JavaScript
		/* Bundler mode */
		"moduleResolution": "bundler",
		"sourceMap": true, // Xuất file *.map cung cấp source map
		"declaration": true, // Có tạo file khai báo (.d.ts) hay không.
		"preserveWatchOutput": true, // Tùy chọn này cho phép giữ lại các file đã biên dịch trước đó ở chế độ watch, nhờ đó tránh việc biên dịch lại do file thay đổi bị xóa trong quá trình biên dịch tăng dần.
		"removeComments": true, // Có loại bỏ comment hay không. Có thể tăng tốc độ biên dịch và giảm kích thước file tạo ra
		"allowImportingTsExtensions": true, // Cho phép import mô-đun có phần mở rộng .ts hoặc .tsx trong câu lệnh import mà không cần chỉ định rõ phần mở rộng
		"resolveJsonModule": true, // Cho phép import mô-đun json
		"isolatedModules": true, // Để TypeScript xử lý mỗi file như một đơn vị độc lập (có thể tăng tốc độ biên dịch)
		"noEmit": true, // Trình biên dịch không tạo bất kỳ file JS nào
		"jsx": "react-jsx",
		// Giúp TypeScript tương thích tốt hơn với mô-đun CommonJS. Khi sử dụng hệ thống mô-đun CommonJS, mô-đun được xuất sẽ được gói trong một đối tượng, vì CommonJS sử dụng cú pháp tương tự module.exports để xuất mô-đun.
		// Và một số công cụ, thư viện có thể cần import các mô-đun CommonJS này theo cách của mô-đun ES6, lúc này có thể bật tùy chọn esModuleInterop.
		// Sau khi bật, khi import mô-đun CommonJS không cần sử dụng default export mới import đúng được, cũng không cần tự xử lý require() và module.exports.
		// Điều này giúp quá trình import và sử dụng mô-đun CommonJS trở nên đơn giản, thuận tiện hơn.
		"esModuleInterop": true,
		/* Linting */
		"strict": true, // Bật tất cả các tùy chọn kiểm tra kiểu nghiêm ngặt
		"strictNullChecks": true, // Kiểm tra nghiêm ngặt đối với giá trị rỗng
		"noImplicitAny": true, // Cấm kiểu any ngầm định
		"noUnusedLocals": true, // Loại bỏ cảnh báo do biến không sử dụng gây ra
		"noUnusedParameters": true, // Loại bỏ cảnh báo do tham số không sử dụng gây ra
		"noFallthroughCasesInSwitch": true, // Tránh rơi vào bẫy (fallthrough) của câu lệnh switch
		"useUnknownInCatchVariables": false, // Khi là true, biến được khai báo trong khối catch sẽ được coi là kiểu unknown thay vì any mặc định.
		// https://vitejs.dev/guide/features#client-types
		"types": ["vite/client"],
		"baseUrl": ".",
		/* alias */
		"paths": {
			"@/*": ["src/*"],
			"#/*": ["types/*"]
		}
	},
	"include": ["src", "types", "tailwind.config.ts"],
	"exclude": ["node_modules", "dist"]
}
