# Tiêu đề ứng dụng
VITE_APP_TITLE=Vben Admin Naive

# Không gian tên của ứng dụng, dùng làm tiền tố cho cache, store và các chức năng khác, đảm bảo cách ly
VITE_APP_NAMESPACE=vben-web-naive

# Khóa mã hóa store, sẽ được dùng để mã hóa khi lưu trữ store bền vững vào localStorage
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key
