VITE_BASE=/

# Địa chỉ API
VITE_GLOB_API_URL=https://mock-napi.vben.pro/api

# Có bật nén không, có thể đặt thành none, brotli, gzip
VITE_COMPRESS=none

# Có bật PWA không
VITE_PWA=false

# Chế độ của vue-router
# Giao thức oauth2.0 yêu cầu callback phải là url đầy đủ
# VITE_ROUTER_HISTORY=hash

# Có chèn loading toàn cục không
VITE_INJECT_APP_LOADING=true

# Sau khi đóng gói có tạo dist.zip không
VITE_ARCHIVER=true

# Có chỉ cho phép đăng nhập OIDC không
VITE_GLOB_AUTH_ONLY_OIDC=false

# Máy chủ xác thực
VITE_GLOB_AUTH_AUTHORITY="http://127.0.0.1:30001"

# Phạm vi ủy quyền
VITE_GLOB_AUTH_AUDIENCE="openid email address phone profile offline_access lingyun-abp-application"

# Id máy khách
VITE_GLOB_AUTH_CLIENT_ID=vue-oauth-client
