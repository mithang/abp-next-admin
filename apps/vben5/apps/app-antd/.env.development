# Số cổng
VITE_PORT=5666

VITE_BASE=/

# Địa chỉ API
VITE_GLOB_API_URL=/

# Có bật dịch vụ Nitro Mock không, true là bật, false là tắt
VITE_NITRO_MOCK=false

# Có mở devtools không, true là mở, false là đóng
VITE_DEVTOOLS=false

# Có inject loading toàn cục không
VITE_INJECT_APP_LOADING=true

# Có chỉ cho phép đăng nhập OIDC không
VITE_GLOB_AUTH_ONLY_OIDC=true
# Máy chủ xác thực
VITE_GLOB_AUTH_AUTHORITY="http://localhost:30000"
# Phạm vi ủy quyền
VITE_GLOB_AUTH_AUDIENCE="openid email address phone profile offline_access lingyun-abp-application"
# Id client
VITE_GLOB_AUTH_CLIENT_ID=vue-admin-client
# Khóa bí mật client【Không đặt giá trị này trong môi trường production, nên bật chỉ cho phép đăng nhập OIDC, sẽ dùng kiểu đăng nhập authorization code】
VITE_GLOB_AUTH_CLIENT_SECRET=1q2w3e*
# Giá trị tùy chọn: login, consent, select_account
# Bỏ chú thích để chọn tài khoản trong đa tenant khi đăng nhập
# VITE_GLOB_AUTH_PROMPT=select_account
# Bỏ chú thích để bắt buộc người dùng nhập thông tin xác thực trong request này khi đăng nhập, làm cho đăng nhập một lần không có hiệu lực
# VITE_GLOB_AUTH_PROMPT=login
# Bỏ chú thích để luôn yêu cầu người dùng ủy quyền khi đăng nhập
# VITE_GLOB_AUTH_PROMPT=consent
