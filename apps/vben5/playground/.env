# Tiêu đề ứng dụng
VITE_APP_TITLE=Vben Admin

# Không gian tên ứng dụng, tiền tố cho cache, store và các chức năng khác, đảm bảo cách ly
VITE_APP_NAMESPACE=vben-web-play

# Khóa mã hóa store, được dùng để mã hóa khi lưu store bền vững vào localStorage
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key
