# Số cổng
VITE_PORT=5555

VITE_BASE=/

# Địa chỉ giao diện
VITE_GLOB_API_URL=/api

# Có bật dịch vụ Nitro Mock hay không, true là bật, false là tắt
VITE_NITRO_MOCK=true

# Có mở devtools hay không, true là mở, false là đóng
VITE_DEVTOOLS=false

# Có chèn loading toàn cục hay không
VITE_INJECT_APP_LOADING=true

# Cấu hình đăng nhập DingTalk
VITE_GLOB_AUTH_DINGDING_CLIENT_ID=clientId_cua_ung_dung
VITE_GLOB_AUTH_DINGDING_CORP_ID=corpId_cua_ung_dung
