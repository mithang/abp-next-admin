[
  {
    "WorkflowName": "TestMultipleRuleInputValidation",
    "Rules": [
      {
        "RuleName": "ValidationInputField",
        "ErrorMessage": "Xác thực trường nhập không hợp lệ!",
        "ErrorType": "Error",
        "Operator": "AndAlso",
        "Rules": [
          {
            "RuleName": "InputRequired",
            "ErrorMessage": "Trường Required bắt buộc phải nhập!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "!string.IsNullOrWhiteSpace(input1.Required)"
          },
          {
            "RuleName": "MustBeGreaterThan100",
            "ErrorMessage": "Trường Integer1 phải lớn hơn 100!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Integer1 > 100"
          },
          {
            "RuleName": "MustBeLessThan100",
            "ErrorMessage": "Trường Integer2 phải nhỏ hơn 100!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Integer2 < 100"
          }
        ]
      },
      {
        "RuleName": "ValidationLengthAndSum",
        "ErrorMessage": "Xác thực độ dài và tổng không hợp lệ!",
        "ErrorType": "Error",
        "Operator": "AndAlso",
        "Rules": [
          {
            "RuleName": "SumMustBeGreaterThan150",
            "ErrorMessage": "Tổng của trường Integer1 và Integer2 phải lớn hơn 200!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Integer1 + input1.Integer2 > 200"
          },
          {
            "RuleName": "RequiredLengthMustBeGreaterThan5",
            "ErrorMessage": "Độ dài trường Length phải lớn hơn 5!",
            "ErrorType": "Error",
            "RuleExpressionType": "LambdaExpression",
            "Expression": "input1.Length.Length > 5"
          }
        ]
      }
    ]
  }
]